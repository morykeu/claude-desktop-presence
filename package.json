{
  "name": "claude-desktop-presence",
  "version": "0.1.0",
  "private": false,
  "description": "Discord Rich Presence daemon for Claude Desktop on Windows",
  "license": "MIT",
  "author": "Kryštof Moravec",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "main": "dist/index.js",
  "bin": {
    "claude-desktop-presence": "dist/index.js"
  },
  "files": [
    "dist",
    "config.example.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node dist/index.js --debug\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "package": "npm run build && npm run check:bundle && pkg dist/index.cjs --config package.json --output release/claude-desktop-presence.exe",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.2.5",
    "koffi": "^3.2.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@yao-pkg/pkg": "^6.22.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "koffi@3.2.1": true
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "release",
    "assets": [
      "node_modules/@koromix/koffi-win32-x64/**/*"
    ]
  }
}
